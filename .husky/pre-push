#!/bin/sh
STAGE=pre-push
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
D="$HOOK_DIR/$STAGE.d"

NVMRC="$HOOK_DIR/../.nvmrc"
if [ -s "$NVMRC" ]; then
	NODE_VER="$(cat "$NVMRC")"
	# nvm stores version directories with a "v" prefix that .nvmrc may omit.
	NODE_BIN="$HOME/.nvm/versions/node/$NODE_VER/bin"
	if [ ! -x "$NODE_BIN/node" ]; then
		NODE_BIN="$HOME/.nvm/versions/node/v$NODE_VER/bin"
	fi
	if [ -x "$NODE_BIN/node" ]; then
		PATH="$NODE_BIN:$PATH"
		export PATH
	fi
fi

[ -d "$D" ] || exit 0

for script in "$D"/*.sh; do
	[ -e "$script" ] || continue
	[ -x "$script" ] || continue
	name="$(basename "$script")"
	echo "[$STAGE] >>> $name"
	"$script" "$@"
done
