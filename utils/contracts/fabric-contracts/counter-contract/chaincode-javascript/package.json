{
    "name": "counter",
    "version": "0.0.1",
    "description": "Counter contract implemented in JavaScript",
    "main": "index.js",
    "engines": {
        "node": ">=12",
        "npm": ">=5"
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "nyc mocha --recursive",
        "mocha": "mocha --recursive",
        "start": "fabric-chaincode-node start"
    },
    "engineStrict": true,
    "author": "Hyperledger",
    "license": "Apache-2.0",
    "dependencies": {
        "fabric-contract-api": "~2.5",
        "fabric-shim": "~2.5"
    },
    "devDependencies": {
        "chai": "^4.1.2",
        "chai-as-promised": "^7.1.1",
        "eslint": "^4.19.1",
        "mocha": "^12.0.1",
        "nyc": "^18.0.0",
        "sinon": "^6.0.0",
        "sinon-chai": "^3.2.0"
    },
    "overrides": {
        "cross-spawn": "^7.0.6",
        "tmp": "^0.2.7"
    },
    "nyc": {
        "exclude": [
            "coverage/**",
            "test/**",
            "index.js",
            ".eslintrc.js"
        ],
        "reporter": [
            "text-summary",
            "html"
        ],
        "all": true,
        "check-coverage": false,
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
    }
}
